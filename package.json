{
  "name": "wow-forever-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Second-screen leveling cheat sheet for World of Warcraft: Forever",
  "homepage": "https://wow.drnz.se/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draindrain/wow-forever-helper.git"
  },
  "bugs": "https://github.com/draindrain/wow-forever-helper/issues",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data": "npm run data:fetch && npm run data:build",
    "data:update": "node --env-file-if-exists=.env scripts/update-agent.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "node-html-parser": "^9.0.5",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
